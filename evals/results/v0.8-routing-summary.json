    "entries": [
      {
        "name": "zhanggui",
        "description": "Use when a development request must be carried from an unclear idea or unresolved design decisions through implementation to verified delivery, when it spans multiple modules or produces multiple deliverables, when an interrupted task with a saved checkpoint is being resumed, or when someone hands over end-to-end ownership of a feature, migration, or redesign.",
        "implicit": true
      },
      {
        "name": "zhanggui-systematic-debugging",
        "description": "Use when a test failure, production bug, build failure, integration failure, performance problem, or otherwise unexpected behavior needs its root cause found, including when earlier fix attempts did not hold or the problem is still not understood.",
        "implicit": true
      },
      {
        "name": "zhanggui-test-driven-development",
        "description": "Use when a new feature, bug fix, refactor, or behavior change is about to be implemented, before any implementation code is written.",
        "implicit": true
      },
      {
        "name": "zhanggui-verification-before-completion",
        "description": "Use when work is about to be called complete, fixed, passing, or ready, or before a commit, push, pull request, or handoff to the next task, and no fresh evidence for that claim has been produced yet.",
        "implicit": true
      },
      {
        "name": "zhanggui-requesting-code-review",
        "description": "Use when a diff, patch, or code change needs a new independent review, including a severity-scoped report of Critical and Important findings, before verification, merge, delivery, or dependent work starts.",
        "implicit": true
      },
      {
        "name": "zhanggui-receiving-code-review",
        "description": "Use when review feedback, reviewer comments, or a findings report has arrived and each item needs technical verification before it is accepted, rejected, or implemented.",
        "implicit": true
      },
      {
        "name": "zhanggui-using-git-worktrees",
        "description": "Use when feature work needs an isolated checkout, a write scope separated from the main working tree, or a dedicated workspace for executing an implementation plan.",
        "implicit": true
      },
      {
        "name": "zhanggui-dispatching-parallel-agents",
        "description": "Use when two or more independent problem domains can run at the same time without shared state or overlapping writes, such as separate root-cause investigations in different components or dependency-ready tasks with non-overlapping files.",
        "implicit": true
      },
      {
        "name": "zhanggui-finishing-a-development-branch",
        "description": "Use when verified branch or worktree work needs an explicit decision about how to land it, such as merging, opening a pull request, keeping the branch, or discarding it, including right after the user says the tests passed.",
        "implicit": true
      }
    ]
  },
